{
  "name": "download-helper",
  "version": "4.5.0",
  "description": "ブックマークレットとかで使うUI",
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./download-helper.ts --outfile ./download-helper.js --format esm --target browser --no-bundle && bun build ./fanbox-collector.ts --outfile ./fanbox-collector.js --format esm --target browser --no-bundle",
    "build:types": "rm -rf dist/types && tsc -p tsconfig.declaration.json",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValerianDillon/download-helper.git"
  },
  "author": "ValerianDillon",
  "license": "MIT",
  "main": "download-helper.js",
  "types": "dist/types/download-helper.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/download-helper.d.ts",
      "default": "./download-helper.js"
    },
    "./download-helper": {
      "types": "./dist/types/download-helper.d.ts",
      "default": "./download-helper.js"
    },
    "./fanbox-collector": {
      "types": "./dist/types/fanbox-collector.d.ts",
      "default": "./fanbox-collector.js"
    }
  },
  "files": [
    "download-helper.js",
    "fanbox-collector.js",
    "dist/types"
  ],
  "bugs": {
    "url": "https://github.com/ValerianDillon/download-helper/issues"
  },
  "homepage": "https://github.com/ValerianDillon/download-helper#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
